# Catch-all: backend/data is runtime-only (models, caches, job dumps).
# Do not commit anything under this tree.
backend/data/

# Generated / cached market data (yfinance seeds, eToro id cache)
backend/data/*.parquet
backend/data/*.json
backend/data/**/*.json
backend/data/archive_wal/
backend/data/meta_label_models/
backend/data/feature_drift/

# Sentiment / news caches written at runtime (keep schema code; ignore local dumps)
backend/data/sentiment/

# Trained ML / DL / RL artifacts (ONNX, joblib, scalers, version snapshots)
backend/data/ml_signal_models/
backend/data/lstm_signal_models/
backend/data/rl_ppo_models/
backend/data/tcn_signal_models/
backend/data/vae_regime_models/
backend/data/transformer_signal_models/
backend/data/gnn_signal_models/
backend/data/gnn_cross_asset_models/
backend/data/_orphans/

# Train-job runtime: epoch checkpoints, Optuna studies, job result dumps
backend/data/ml_checkpoints/
backend/data/optuna/
backend/data/ml_job_results/

# Copilot intent LoRA (live chat pairs, adapter weights, meta)
backend/data/copilot_intent/

# Per-bot fitted artifacts written at runtime
backend/data/calibration/
backend/data/conformal/
backend/data/hmm_regime/
backend/data/stacking/
backend/data/strategy_state/
backend/data/journal_screenshots/

# IB contract resolve cache + local seed dumps next to the app package
backend/app/data/*.json
backend/app/data/*.parquet

# Prompt-library live corrections (committed files are the versioned *.json exemplars)
backend/app/services/agent/prompt_library/*.jsonl
backend/app/services/agent/prompt_library/negative_examples.jsonl

