# Alpaca stocks + crypto + options feed — fourth instance (ports 8795/8796, UI :5176)
# Requires ALPACA_API_KEY + ALPACA_SECRET_KEY in repo-root .env (shared secrets).
# Launched via:  scripts/start-alpaca.ps1  or  TERMINAL_PROFILE=alpaca python main.py

TERMINAL_MODE=LIVE_ALPACA
TERMINAL_ROLE=all

WS_PORT=8795
HTTP_PORT=8796

SQLITE_DB_PATH=trading-alpaca.db

# Equity stream: auto | sip | iex (auto probes SIP entitlement, falls back to IEX)
ALPACA_DATA_FEED=auto
# ALPACA_DATA_URL=wss://stream.data.alpaca.markets/v2/sip
# ALPACA_BROADCAST_INTERVAL_SEC=1.5

# Crypto (v1beta3) — terminal symbols stay *USDT; feed maps to Alpaca BTC/USD etc.
ALPACA_CRYPTO_ENABLED=true
# ALPACA_CRYPTO_WS_URL=wss://stream.data.alpaca.markets/v1beta3/crypto/us

# Options (v1beta1 msgpack) — indicative (default) or opra when entitled
ALPACA_OPTIONS_ENABLED=true
ALPACA_OPTION_FEED=indicative
ALPACA_OPTION_UNDERLYINGS=SPY,QQQ,AAPL
# ALPACA_OPTION_SYMBOLS=   # optional explicit OCC list (comma-separated)

# Paper trading URL (override in root .env for live)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# History for ML / backtest / bots / archive uses Alpaca REST on this profile
# (even if MASSIVE_API_KEY is also set in repo-root .env).

# Real Alpaca OMS — bots require ALLOW_LIVE_BOTS (paper recommended first).
ALLOW_LIVE_BOTS=true

# Keep 1m archive lean for live feed + bots (parity with Massive profile).
ARCHIVE_RETENTION_1M_DAYS=14
ARCHIVE_ROLLUP_INTERVAL=1800
DIAGNOSTICS_STATS_CACHE_SEC=30

# Nested FIT → EMBARGO → HOLDOUT for ML Lab (anti-overfit).
ML_CALENDAR_HOLDOUT=1
